# Supabase client (browser / app)
VITE_SUPABASE_URL=https://ilclznhrlrirgmvwmunl.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_publishable_key

# Canonical public app URL (Site URL / Redirect allow-list in Supabase Auth).
# Local `npm run dev` ignores this and uses http://localhost:5173 instead.
# Login uses 6-digit email OTP (not magic links). In Supabase Dashboard →
# Authentication → Email Templates → Magic Link, include {{ .Token }} so the
# email shows the code users enter in the app.
VITE_SITE_URL=https://game-day-app-chvm.vercel.app

# Optional: personal access token for scripts/update-otp-email-template.mjs
# Create at https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_PROJECT_REF=ilclznhrlrirgmvwmunl

# Direct Postgres for `npm run db:migrate` and one-off scripts only.
# Prefer the Transaction pooler (port 6543) — serverless-safe, IPv4.
# Do not point Vercel functions at this URL; they use VITE_SUPABASE_URL over HTTPS.
# SUPABASE_DB_URL=postgresql://postgres.ilclznhrlrirgmvwmunl:YOUR_DB_PASSWORD@aws-0-us-east-2.pooler.supabase.com:6543/postgres
# Session pooler (port 5432 on *.pooler.supabase.com) is for long-lived clients, not functions.
# Direct db.*:5432 is IPv6-only and will fail on many networks:
# SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.ilclznhrlrirgmvwmunl.supabase.co:5432/postgres

# Parent Hub Web Push
# Generate with: npx web-push generate-vapid-keys
# Put the full trio in `.env.local` (gitignored). Public key must be VITE_-prefixed.
# Server routes (`api/match/*`, `api/send-web-push`) read VAPID_* from Vercel env.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@virginiavelocity.com

# Optional: Sentry crash reporting. Leave blank to disable.
# Create a React project DSN at https://sentry.io
# Browser uses VITE_SENTRY_DSN. Vercel functions use SENTRY_DSN (falls back to VITE_).
VITE_SENTRY_DSN=
SENTRY_DSN=

# Match orchestration APIs (`/api/match/*`) use the same Supabase URL + anon/publishable
# key as the browser (user JWT forwarded). Do not put SUPABASE_SERVICE_ROLE_KEY in Vite env.
# Never prefix secrets with VITE_ (VITE_SUPABASE_SERVICE_ROLE_KEY / VITE_VAPID_PRIVATE_KEY).
# Server-only (not needed by match writes): SUPABASE_SERVICE_ROLE_KEY=

# Optional Playwright happy-path for /api/match/* (skipped locally when unset).
# In GitHub Actions these MUST be set as repository secrets or CI fails:
#   VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY,
#   E2E_STAFF_EMAIL, E2E_STAFF_PASSWORD,
#   E2E_TEAM_SLUG (or E2E_TEAM_ID)
# Use a staff account that can write is_test matches for that team (2+ rostered players).
# Optional: E2E_SEASON_ID (otherwise the first active season).
# Optional for Vercel Deployment Protection: VERCEL_AUTOMATION_BYPASS_SECRET
# E2E_STAFF_EMAIL=
# E2E_STAFF_PASSWORD=
# E2E_STAFF_ACCESS_TOKEN=
# E2E_TEAM_SLUG=
# E2E_TEAM_ID=
# E2E_SEASON_ID=
